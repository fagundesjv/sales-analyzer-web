    "build:design": "next build",
    "start": "npm run previa",
    "start:design": "python3 scripts/preview.py 4317",
    "test:e2e": "node tests/operacao-e2e.mjs && node tests/operacao-e2e.mjs --mobile && npm run test:atendimento && npm run test:workspace && npm run test:conversas && npm run test:interface && npm run test:campos && npm run test:responsivo && npm run test:plataforma && npm run test:negociacoes && npm run test:navegacao && npm run test:rede && npm run test:plano",
    "test:atendimento": "node tests/atendimento-e2e.mjs",
    "build:produto": "node produto/portal.mjs --build",
    "start:produto": "node produto/portal.mjs --serve",
    "test:workspace": "node tests/workspace-e2e.mjs",
    "test:conversas": "node tests/conversas-e2e.mjs",
    "test:interface": "node tests/interface-e2e.mjs",
    "test:campos": "node tests/campos-e2e.mjs",
    "test:responsivo": "node tests/responsivo-e2e.mjs",
    "test:plano": "node tests/plano-e2e.mjs",
    "test:rede": "node tests/rede-e2e.mjs",
    "test:plataforma": "node tests/plataforma-e2e.mjs",
    "test:navegacao": "node tests/navegacao-e2e.mjs",
    "test:negociacoes": "node tests/negociacoes-e2e.mjs",
    "test:portal-integrado": "node tests/portal-pilot.mjs",
    "piloto:local": "node tests/portal-pilot.mjs --serve",
    "dev:integrado": "node --env-file-if-exists=../sales-analyzer-backend/.local/bff.env server/web.mjs",
    "test:v2-integrada": "node tests/v2-integrada.mjs",
    "test:v2-zoe": "node tests/v2-zoe.mjs",
    "package:privado": "node scripts/package-private.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@content-ventures/design-system": "https://github.com/content-ventures/design-system/archive/d7410a5fb3ebd7dec622395b2ce72faeaa0d1886.tar.gz",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "0.555.0",
    "next": "16.3.8",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
