{
  "name": "sales-analyzer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:produto": "node produto/portal.mjs",
    "test:produto": "node produto/portal.mjs --test",
    "test:portal": "node tests/portal-e2e.mjs",
    "test:zoe": "node tests/zoe-portal-e2e.mjs",
    "dev": "npm run dev:design",
